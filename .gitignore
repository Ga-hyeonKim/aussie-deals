*.tsbuildinfo
next-env.d.ts

# Google OAuth credentials
client_secret*.json

/app/generated/prisma

# scraper intermediate dump
scripts/woolworths-dump.json
scripts/coles-dump.json
scripts/coles-all-dump.json
scripts/brands-export.json
